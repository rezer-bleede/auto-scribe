# ============================================================
# auto-scribe environment configuration
# Copy this file to `.env` and fill in your real secrets.
# NEVER commit the real `.env` file to version control.
# ============================================================

# --- OpenAI (article generation) ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- GitHub (Pages publishing) ---
# A personal access token with `repo` scope (classic) or
# `Contents: Write` on the target repo (fine-grained).
GITHUB_TOKEN=ghp_your-github-token-here
GITHUB_USERNAME="rezer-bleede"
GITHUB_REPO="auto-scribe"

# --- Optional overrides (sane defaults are set in config.py) ---
# OPENAI_MODEL=gpt-4o
# MEDIUM_STATE_FILE=medium_state.json
